MONGO_DB_URI=mongodb://127.0.0.1:27017/yet-another-mtg-database

# For bulk data import
ALL_CARDS_FILE=bulk-data/oracle-cards-20251025210907.json

# Scryfall API base URL (used to fetch individual cards, set icons, and prices on demand)
SCRYFALL_API_BASE_URL=https://api.scryfall.com

# Currency exchange-rate API base URL (used by GET /api/exchange-rate to convert
# USD card prices into the user's chosen currency). Defaults to Frankfurter,
# which is free and needs no API key.
EXCHANGE_RATE_API_BASE_URL=https://api.frankfurter.dev/v1

# Dev-only login: set to "true" (never active in production — also gated on
# NODE_ENV) to add a "Continue as dev user" button to the login page. Signs in
# as a fixed local user via a real NextAuth session, so AUTH_SECRET and
# NEXTAUTH_URL (http://localhost:3000 in dev) are still required — but the
# Google OAuth vars are not. `npm run dev:devlogin` sets it for you.
AUTH_DEV_LOGIN=false

# For Google OAuth (not required when using AUTH_DEV_LOGIN)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
AUTH_SECRET=your_random_secret_key

# Card scanner backend (proxied by POST /api/scan)
SCANNER_BASE_URL=http://localhost:8000

# Optional: encrypts secrets stored in user settings (currently the per-user AI
# API key) at rest with AES-256-GCM. Without it, stored secrets are kept in
# plaintext (a one-time server warning is logged). Generate with:
#   openssl rand -hex 32
# SETTINGS_ENCRYPTION_KEY=64_hex_characters

# For Next Auth (http://localhost:3000 for local dev)
NEXTAUTH_URL=https://yourdomain.com